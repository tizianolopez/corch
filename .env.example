# ==============================================================================
# CORCHETES — Configuración de Variables de Entorno de Producción
# ==============================================================================

# ── Entorno y Servidor (apps/api en Railway) ──────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── URLs Públicas de Producción ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://corchetes.es
NEXT_PUBLIC_API_URL=https://api.corchetes.es
API_URL=https://api.corchetes.es

# ── Base de Datos (PostgreSQL / Supabase en packages/db y apps/api) ───────────
# Conexión directa o a través del pooler de Supabase (modo session o transaction)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Upstash Redis (Caché de percentiles y rate-limiting en apps/api) ──────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ── Supabase Auth (apps/web y apps/cms) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key

# ── Agente Generador IA (apps/api) ────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Seguridad y Tareas Programadas (apps/api y apps/cms) ──────────────────────
ADMIN_TOKEN=your_super_secret_admin_token_for_api
CRON_SECRET=your_secret_token_for_cloudflare_cron_trigger

# ── Cloudflare (Purgado de caché automático al publicar puzles) ───────────────
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_purge_token
